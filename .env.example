# Copy to .env and fill in. docker-compose.yml loads it automatically; .env is
# gitignored. None of these are needed for the smoke test, RQ1, RQ2, or for
# re-running the models on the shipped adversarial samples.

# --- RQ3: generating adversarial samples -----------------------------------
# Used by generate-adversarial-sample-gpt-4.py to call GPT-4o.
# Only needed if you are regenerating the adversarial samples rather than
# using the ones shipped with this artifact.
OPENAI_API_KEY=

# --- RQ3: verifying adversarial samples still compile and pass -------------
# Used by submit2leetcode.py. Log in at https://leetcode.com, then copy these
# two cookies from your browser's developer tools.
LEETCODE_CSRF_TOKEN=
LEETCODE_SESSION=

# --- Optional: Hugging Face --------------------------------------------------
# Only needed for gated or rate-limited model downloads. CodeBERT,
# GraphCodeBERT, UniXcoder, DeepSeek-Coder and Code Llama are all public.
HF_TOKEN=

# --- Optional: container tuning ---------------------------------------------
# OMP_NUM_THREADS=4

# Force a specific attention backend instead of autodetecting
# (flash_attention_2 | sdpa | eager). See attn_backend.py.
# ATTN_IMPLEMENTATION=

# --- Linux hosts: file ownership --------------------------------------------
# The container runs as a non-root user built with these IDs. Set them to your
# own `id -u` / `id -g` so results, models and figures written into the
# bind-mounted repository stay owned by you rather than by root.
# Not needed on macOS or Windows — Docker Desktop remaps ownership already.
# CAA_UID=1000
# CAA_GID=1000
