      given-names: A. K.
    - family-names: Yao
      given-names: Z.
    - family-names: Moran
      given-names: K.
  journal: "ACM Transactions on Software Engineering and Methodology (TOSEM)"
  publisher:
    name: "Association for Computing Machinery"
  year: 2026
