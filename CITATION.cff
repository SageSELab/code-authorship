# assigns one.
authors:
  - family-names: Dipongkor
    given-names: A. K.
  - family-names: Yao
    given-names: Z.
  - family-names: Moran
    given-names: K.

keywords:
  - code authorship attribution
  - language models
  - adversarial robustness
  - empirical software engineering

preferred-citation:
  type: article
  title: "Reassessing Code Authorship Attribution in the Era of Language Models"
  authors:
