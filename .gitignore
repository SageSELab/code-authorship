# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Secrets
.env

# Tree-sitter: grammar checkouts and compiled parsers are build artifacts.
# Rebuild with scripts/build-tree-sitter.sh.
tree-sitter-so/
tree-sitter-c/
tree-sitter-cpp/
tree-sitter-c-sharp/
tree-sitter-java/
tree-sitter-javascript/
tree-sitter-python/
tree-sitter-ruby/
*.so

# ContraBERT checkpoints (fetched with scripts/fetch-contrabert.sh)
/ContraBERT_C/
/ContraBERT_G/

# Experiment outputs, under data/{dataset}/{model}/.
#
# These must stay anchored at data/*/*/ — a generic */*/ pattern also matches
# data/{dataset}/data/, which would silently ignore the shipped dataset folds.
data/*/*/models/
data/*/*/results/
data/*/*/explanations/
data/*/*/data/
data/*/*/finetuned_fold_*/
data/*/*/fold/

# Path contexts generated for PbNN (large; regenerate with
# src/pathcontexts/generate_path_contexts.sh). The shipped fold_*.csv files
# next to them are tracked and must not be caught by this.
data/*/data/*.json

# Pipeline outputs written to the repository root
/models/
/results/
/explanations/
/VerifiedOriginalSamples/
all_models_all_corrects.json
all-corrects.json
leetcode-all-models-corrects.json
leetcode-all-models-corrects-intersection.json
leetcode-all-models-corrects-intersection.csv
leetcode-language_wise_results.csv
adversarial-samples-GPT4.csv

# RQ3 intermediate outputs
Adversarial-Samples-GPT4/
Invalid-Transformations/
Submissions/
Submissions-Error/
Picked/

# Generated tables and figures
best_config_results.csv
all_configs_results.csv
all_models_correct_samples.csv
positive_contributions.csv
